%% The one page as the proof surface: length controls + card-grid parity
%% Render with: https://mermaid.live or any Mermaid-capable Markdown viewer
flowchart TD
    NAV["Header nav [data-nav-key]<br/>Proof · What I do · About · Work<br/>Experience · Skills · Contact"] --> IDX

    subgraph IDX["/index.html — the whole site"]
        HERO["#top hero: claim + metrics"]
        ABOUT["#about"]
        FEAT["#work — pf-grid--2 (8 case studies)"]
        TL["#experience — full role timeline<br/>newest role open, earlier collapsed"]
        BTN["[data-role-toggle]<br/>Show 2 earlier roles"]
        SKILLS["#skills — rows carry data-tech"]
        CONTACT["#contact"]
        HERO --> ABOUT --> FEAT --> TL --> BTN --> SKILLS --> CONTACT
    end

    SKILLS -- "data-tech click" --> TL

    IDX --> JS["pages/index/js/index.js<br/>chips, collapse, data-tech, ?tech="]
    JS --> FILT["utils/experience-filter.js<br/>matchesTag / filterRolesByTag"]
    JS --> SECT["utils/home-sections.js<br/>resolveActiveSection<br/>limitRoles · describeRoleToggle"]
    FILT --> TL
    SECT --> TL
    SECT --> SITE["pages/shared/js/site.js"]
    SITE -- "aria-current" --> NAV
    SECT -- "label + aria-expanded" --> BTN

    THEMETOK["theme.css --pf-header-h"] --> NAV

    subgraph GRID["Card grid parity — pages/shared/css/layout.css"]
        G1["pf-grid--2 pins 2 columns"]
        G2["last child at an odd index spans 1 / -1"]
        G3["work.js marks .is-last-visible after filtering"]
        G1 --> G2 --> G3
    end

    FEAT -.-> GRID
    ABOUT -.-> GRID
    CONTACT -.-> GRID

    UNIT["test/home-sections.test.js<br/>scroll-spy + collapse edge cases"] --> SECT
    TEST["test/page-markup.test.js<br/>grid parity, nav targets,<br/>hidden toggle, no exp- names"] --> IDX
    TEST --> GRID
