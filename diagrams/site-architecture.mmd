%% Jamie Tucker Portfolio — multi-page static site architecture
%% Render with: https://mermaid.live or any Mermaid-capable Markdown viewer
flowchart LR
    subgraph Visitor
        R([Recruiter or hiring manager])
    end

    subgraph Entry["Entry point"]
        IDX["/index.html<br/>hook + metrics + featured work"]
    end

    subgraph PagesGroup["pages/ — one folder per route"]
        AB["about/html/about.html<br/>story, principles, education"]
        EX["experience/html/experience.html<br/>timeline + ?tech= filter"]
        PR["projects/html/projects.html<br/>problem / approach / outcome"]
        SK["skills/html/skills.html<br/>depth labels + deep links"]
        CT["contact/html/contact.html<br/>email, LinkedIn, resume"]
    end

    subgraph SharedGroup["pages/shared/ — chrome for every page"]
        THEME["css/theme.css<br/>--pf-* tokens + typography"]
        LAYOUT["css/layout.css<br/>nav, cards, footer, tour"]
        TINIT["js/theme-init.js<br/>set data-theme pre-paint"]
        SITE["js/site.js<br/>active nav, menu, reveal, tour"]
    end

    subgraph UtilsGroup["utils/ — UMD data and pure logic"]
        RESUME["resume-data.js"]
        PROJDATA["project-data.js"]
        NAV["site-nav.js"]
        FILTER["experience-filter.js"]
        THEMEPREF["theme-preference.js"]
    end

    subgraph TestGroup["test/ — node assert suites"]
        UNIT["5 unit suites"]
        MARKUP["page-markup.test.js<br/>markup vs data + link check"]
    end

    subgraph MediaGroup["media/"]
        PDF["docs/jamie-tucker-resume.pdf"]
        IMG["images/profile.jpeg"]
    end

    R --> IDX
    IDX --> AB
    IDX --> EX
    IDX --> PR
    IDX --> CT
    SK -- "?tech=React" --> EX
    EX --> PR
    PR --> CT
    IDX --> PDF
    IDX --> IMG

    THEME --> LAYOUT
    LAYOUT --> IDX
    LAYOUT --> PagesGroup
    THEMEPREF --> TINIT
    TINIT --> PagesGroup
    NAV --> SITE
    SITE --> PagesGroup
    RESUME --> EX
    RESUME --> PR
    FILTER --> EX
    FILTER --> PR

    RESUME --> UNIT
    PROJDATA --> UNIT
    NAV --> UNIT
    FILTER --> UNIT
    THEMEPREF --> UNIT
    IDX --> MARKUP
    PagesGroup --> MARKUP
